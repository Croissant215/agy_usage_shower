<Window x:Class="AgyUsageShower.Views.DetailCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Usage Details"
        Width="320" Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated">

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#313244" BorderThickness="1.5" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.5" Direction="270" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ AGY Quotas" Foreground="#CDD6F4" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentUsage.TierName}" Foreground="#A6ADC8" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right" Foreground="#A6ADC8" Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand"/>
            </DockPanel>

            <!-- Body Details -->
            <StackPanel Grid.Row="1">
                <!-- 5-Hour Refresh Quota -->
                <DockPanel Margin="0,2,0,2">
                    <TextBlock Text="5-Hour Refresh Quota (5h Sprint)" Foreground="#89B4FA" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Quota5hFormatted}" Foreground="#89B4FA" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                </DockPanel>
                <Grid Margin="0,2,0,4">
                    <ProgressBar Height="8" Value="{Binding CurrentUsage.Quota5hPercent}" Minimum="0" Maximum="100" Foreground="{Binding Color5hHex}" Background="#313244"/>
                </Grid>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="5h Next Reset:" Foreground="#A6ADC8" FontSize="10"/>
                    <TextBlock Text="{Binding CurrentUsage.Reset5hCountdown}" Foreground="#F9E2AF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- Weekly Baseline Quota -->
                <DockPanel Margin="0,2,0,2">
                    <TextBlock Text="Weekly Baseline Quota (Hard Cap)" Foreground="#CBA6F7" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding WeeklyFormatted}" Foreground="#CBA6F7" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                </DockPanel>
                <Grid Margin="0,2,0,4">
                    <ProgressBar Height="8" Value="{Binding CurrentUsage.WeeklyQuotaPercent}" Minimum="0" Maximum="100" Foreground="{Binding ColorWeeklyHex}" Background="#313244"/>
                </Grid>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Weekly Reset In:" Foreground="#A6ADC8" FontSize="10"/>
                    <TextBlock Text="{Binding CurrentUsage.WeeklyResetCountdown}" Foreground="#A6ADC8" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/>
                </DockPanel>
            </StackPanel>

            <!-- Footer -->
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="Updated just now" Foreground="#585B70" FontSize="10" VerticalAlignment="Center"/>
                <Button Content="🔄 Refresh" Click="RefreshButton_Click" HorizontalAlignment="Right" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Padding="8,4" FontSize="10" Cursor="Hand"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
