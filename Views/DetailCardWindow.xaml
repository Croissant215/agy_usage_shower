<Window x:Class="AgyUsageShower.Views.DetailCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Models &amp; Quotas"
        Width="360" Height="370"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated">

    <Border Background="{Binding CardBgHex}" CornerRadius="12" BorderBrush="{Binding WidgetBorderHex}" BorderThickness="1.5" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.5" Direction="270" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Vertical">
                    <DockPanel>
                        <TextBlock Text="⚡ AGY Models &amp; Quotas" Foreground="{Binding MainTextHex}" FontSize="14" FontWeight="Bold"/>
                        <Button Content="{Binding ThemeIcon}" Click="ThemeToggle_Click" Background="Transparent" BorderThickness="0" FontSize="12" Margin="8,0,0,0" Cursor="Hand"/>
                    </DockPanel>
                    <TextBlock Text="{Binding CurrentUsage.StatusBadgeText}" Foreground="{Binding BrandPinkHex}" FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right" Foreground="{Binding SubTextHex}" Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand" VerticalAlignment="Top"/>
            </DockPanel>

            <!-- Body Details -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- GEMINI MODELS -->
                    <Border Background="{Binding ProgressBgHex}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="GEMINI MODELS" Foreground="{Binding BrandPinkHex}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Gemini Flash, Gemini Pro" Foreground="{Binding SubTextHex}" FontSize="9.5" Margin="0,1,0,8"/>

                            <!-- Weekly Limit -->
                            <DockPanel Margin="0,2,0,1">
                                <TextBlock Text="Weekly Limit" Foreground="{Binding MainTextHex}" FontSize="10"/>
                                <TextBlock Text="{Binding CurrentUsage.GeminiWeeklyPercent, StringFormat='{}{0:F2}%'}" Foreground="{Binding ProgressWkHex}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar Height="6" Value="{Binding CurrentUsage.GeminiWeeklyPercent}" Minimum="0" Maximum="100" Foreground="{Binding ProgressWkHex}" Background="{Binding WidgetBgHex}" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding CurrentUsage.GeminiWeeklyPercent, StringFormat='{}{0:F0}% remaining · Refreshes in 167h 41m'}" Foreground="{Binding SubTextHex}" FontSize="9" Margin="0,0,0,8"/>

                            <!-- Five Hour Limit -->
                            <DockPanel Margin="0,2,0,1">
                                <TextBlock Text="Five Hour Limit" Foreground="{Binding MainTextHex}" FontSize="10"/>
                                <TextBlock Text="{Binding CurrentUsage.Gemini5hPercent, StringFormat='{}{0:F2}%'}" Foreground="{Binding BrandPinkHex}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar Height="6" Value="{Binding CurrentUsage.Gemini5hPercent}" Minimum="0" Maximum="100" Foreground="{Binding BrandPinkHex}" Background="{Binding WidgetBgHex}" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding CurrentUsage.GeminiResetTime, StringFormat='{}{0} remaining · Refreshes live'}" Foreground="{Binding SubTextHex}" FontSize="9"/>
                        </StackPanel>
                    </Border>

                    <!-- CLAUDE AND GPT MODELS -->
                    <Border Background="{Binding ProgressBgHex}" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="CLAUDE AND GPT MODELS" Foreground="#00E676" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Claude Opus, Claude Sonnet, GPT-OSS" Foreground="{Binding SubTextHex}" FontSize="9.5" Margin="0,1,0,8"/>

                            <!-- Weekly Limit -->
                            <DockPanel Margin="0,2,0,1">
                                <TextBlock Text="Weekly Limit" Foreground="{Binding MainTextHex}" FontSize="10"/>
                                <TextBlock Text="100.00%" Foreground="#00E676" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar Height="6" Value="100" Minimum="0" Maximum="100" Foreground="#00E676" Background="{Binding WidgetBgHex}" Margin="0,2,0,2"/>
                            <TextBlock Text="Quota available" Foreground="{Binding SubTextHex}" FontSize="9" Margin="0,0,0,8"/>

                            <!-- Five Hour Limit -->
                            <DockPanel Margin="0,2,0,1">
                                <TextBlock Text="Five Hour Limit" Foreground="{Binding MainTextHex}" FontSize="10"/>
                                <TextBlock Text="100.00%" Foreground="#00E676" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar Height="6" Value="100" Minimum="0" Maximum="100" Foreground="#00E676" Background="{Binding WidgetBgHex}" Margin="0,2,0,2"/>
                            <TextBlock Text="Quota available" Foreground="{Binding SubTextHex}" FontSize="9"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: Account Actions -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{Binding CurrentUsage.LoginButtonText}" Click="SwitchAccountButton_Click" Background="{Binding ProgressBgHex}" Foreground="{Binding BrandPinkHex}" BorderThickness="0" Padding="6,4" FontSize="9.5" FontWeight="Bold" Cursor="Hand" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Content="🚪 로그아웃" Visibility="{Binding CurrentUsage.LogoutVisibility}" Click="LogoutButton_Click" Background="{Binding ProgressBgHex}" Foreground="{Binding SubTextHex}" BorderThickness="0" Padding="6,4" FontSize="9.5" Cursor="Hand"/>
                <Button Grid.Column="2" Content="🔄 Sync" Click="RefreshButton_Click" HorizontalAlignment="Right" Background="{Binding ProgressBgHex}" Foreground="{Binding MainTextHex}" BorderThickness="0" Padding="8,4" FontSize="9.5" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
