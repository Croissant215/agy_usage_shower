<Window x:Class="AgyUsageShower.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AgyUsageShower.Controls"
        Title="AGY RunCat Overlay"
        Width="180" Height="34"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Border Background="#181825" CornerRadius="6" BorderBrush="#313244" BorderThickness="1" Margin="1" Cursor="Hand">
        <Border.ToolTip>
            <ToolTip Content="RunCat Antigravity Quota Monitor: Gemini Weekly 35.09%, 5h 29.17% (Reset in 7m). Click for details."/>
        </Border.ToolTip>

        <Grid Margin="4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- RunCat Running Cat Animation -->
            <controls:RunCatControl Grid.Column="0" RemainingQuotaPercent="{Binding CurrentUsage.Gemini5hPercent}" VerticalAlignment="Center" Margin="2,0,6,0"/>

            <!-- Quotas: 5h & Weekly -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Row: 5h limit -->
                <DockPanel Grid.Row="0">
                    <TextBlock Text="5h" Foreground="#89B4FA" FontSize="9" FontWeight="Bold" Width="18"/>
                    <TextBlock Text="{Binding Quota5hFormatted}" Foreground="#CDD6F4" FontSize="9" FontWeight="SemiBold" Width="38"/>
                    <ProgressBar Height="3" Value="{Binding CurrentUsage.Gemini5hPercent}" Minimum="0" Maximum="100" Margin="2,0,4,0" Foreground="{Binding Color5hHex}" Background="#313244" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUsage.GeminiResetTime}" Foreground="#F9E2AF" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Bottom Row: Weekly limit -->
                <DockPanel Grid.Row="1" Margin="0,1,0,0">
                    <TextBlock Text="Wk" Foreground="#CBA6F7" FontSize="9" FontWeight="Bold" Width="18"/>
                    <TextBlock Text="{Binding WeeklyFormatted}" Foreground="#CDD6F4" FontSize="9" FontWeight="SemiBold" Width="38"/>
                    <ProgressBar Height="3" Value="{Binding CurrentUsage.GeminiWeeklyPercent}" Minimum="0" Maximum="100" Margin="2,0,4,0" Foreground="{Binding ColorWeeklyHex}" Background="#313244" VerticalAlignment="Center"/>
                    <TextBlock Text="7m" Foreground="#A6ADC8" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
