<Window x:Class="AgyUsageShower.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AGY Taskbar Widget"
        Width="380" Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Border Background="#161622" CornerRadius="6" BorderBrush="#2B2D3A" BorderThickness="1" Margin="1" Cursor="Hand">
        <Border.ToolTip>
            <ToolTip Content="AGY Quota Monitor: Gemini 5h 29.17% (7m), Weekly 35.09%, Claude 100%. Click for details."/>
        </Border.ToolTip>

        <Grid Margin="8,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Brand -->
                <ColumnDefinition Width="Auto"/> <!-- Separator -->
                <ColumnDefinition Width="*"/>    <!-- Gemini 5h & Wk -->
                <ColumnDefinition Width="Auto"/> <!-- Separator -->
                <ColumnDefinition Width="Auto"/> <!-- Claude -->
            </Grid.ColumnDefinitions>

            <!-- Brand -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <TextBlock Text="⚡" FontSize="11" Margin="0,0,3,0"/>
                <TextBlock Text="AGY" Foreground="#89B4FA" FontSize="11" FontWeight="Bold"/>
            </StackPanel>

            <Rectangle Grid.Column="1" Fill="#2B2D3A" Width="1" Margin="0,4"/>

            <!-- Gemini 5h & Weekly -->
            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: 5h Limit -->
                <Grid Grid.Row="0" Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="5h" Foreground="#89B4FA" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Quota5hFormatted}" Foreground="#CDD6F4" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="2" Height="4" Value="{Binding CurrentUsage.Gemini5hPercent}" Minimum="0" Maximum="100" Margin="4,0" Foreground="{Binding Color5hHex}" Background="#2B2D3A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding CurrentUsage.GeminiResetTime}" Foreground="#F9E2AF" FontSize="9" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Row 1: Weekly Limit -->
                <Grid Grid.Row="1" Margin="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Wk" Foreground="#CBA6F7" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding WeeklyFormatted}" Foreground="#CDD6F4" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="2" Height="4" Value="{Binding CurrentUsage.GeminiWeeklyPercent}" Minimum="0" Maximum="100" Margin="4,0" Foreground="{Binding ColorWeeklyHex}" Background="#2B2D3A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="7m" Foreground="#A6ADC8" FontSize="9" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Rectangle Grid.Column="3" Fill="#2B2D3A" Width="1" Margin="0,4"/>

            <!-- Claude & GPT Status -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
                <TextBlock Text="Claude " Foreground="#A6ADC8" FontSize="9.5"/>
                <TextBlock Text="100%" Foreground="#A6E3A1" FontSize="9.5" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
